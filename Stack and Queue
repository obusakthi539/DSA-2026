        Scanner sc = new Scanner(System.in);
        Stack s = new Stack();

        int n = sc.nextInt();

        for (int i = 0; i < n; i++) {
            String op = sc.next();

            if (op.equals("Push")) {
                String name = sc.next();
                s.push(name);
            }
            else if (op.equals("Pop")) {
                s.pop();
            }
            else if (op.equals("Top")) {
                s.top();
            }
            else if (op.equals("IsEmpty")) {
                System.out.println(s.isEmpty());
            }
            else if (op.equals("Size")) {
                System.out.println(s.size());
            }
        }
    }
}

class Node {
    String data;
    Node next;

    Node(String d) {
        data = d;
        next = null;
    }
}

class Stack {
    Node top;
    int count = 0;

    public void push(String name) {
        Node newNode = new Node(name);

        newNode.next = top;
        top = newNode;

        count++;
    }

    public void pop() {
        if (top == null) {
            System.out.println("Stack Underflow");
            return;
        }

        top = top.next;
        count--;
    }

    public void top() {
        if (top == null) {
            System.out.println("Stack Underflow");
            return;
        }

        System.out.println(top.data);
    }

    public boolean isEmpty() {
        return top == null;
    }

    public int size() {
        return count;
    }
}

