class MyStack {
    int a[] = new int[100];
    int top = -1;

    public void push(int x) {
        if (top == 99) {
            return;
        }

        top++;
        a[top] = x;
    }

    public void pop() {
        if (top == -1) {
            System.out.println("Stack Underflow");
            return;
        }

        top--;
    }

    public void displayTop() {
        if (top == -1) {
            System.out.println("Stack Underflow");
            return;
        }

        System.out.println(a[top]);
    }

    public boolean isEmpty() {
        return top == -1;
    }

    public int size() {
        return top + 1;
    }
}
