class Node {
    String data;
    Node next;

    Node(String d) {
        data = d;
        next = null;
    }
}

class Stack {
    Node top;
    int count = 0;

    public void push(String name) {
        Node newNode = new Node(name);

        newNode.next = top;
        top = newNode;

        count++;
    }

    public void pop() {
        if (top == null) {
            System.out.println("Stack Underflow");
            return;
        }

        top = top.next;
        count--;
    }

    public void top() {
        if (top == null) {
            System.out.println("Stack Underflow");
            return;
        }

        System.out.println(top.data);
    }

    public boolean isEmpty() {
        return top == null;
    }

    public int size() {
        return count;
    }
}
