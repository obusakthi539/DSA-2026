import java.util.*;

public class Main {
    public static void main(String args[]) {
        Scanner sc = new Scanner(System.in);

        int size = sc.nextInt();
        int n = sc.nextInt();

        CircularQueue q = new CircularQueue(size);

        for (int i = 0; i < n; i++) {
            String op = sc.next();

            if (op.equals("enqueue")) {
                int x = sc.nextInt();
                if (q.enqueue(x))
                    System.out.println("Booked seat: " + x);
                else
                    System.out.println("Booking failed");
            }
            else if (op.equals("dequeue")) {
                if (q.isEmpty())
                    System.out.println("No booking to cancel");
                else
                    System.out.println("Canceled seat: " + q.dequeue());
            }
            else if (op.equals("front")) {
                if (q.isEmpty())
                    System.out.println("No bookings");
                else
                    System.out.println("Next seat to be canceled: " + q.front());
            }
            else if (op.equals("isFull")) {
                System.out.println(q.isFull());
            }
            else if (op.equals("isEmpty")) {
                System.out.println(q.isEmpty());
            }
        }
    }
}

class CircularQueue {
    int a[];
    int front = 0;
    int rear = -1;
    int count = 0;
    int size;

    CircularQueue(int size) {
        this.size = size;
        a = new int[size];
    }

    public boolean enqueue(int x) {
        if (isFull())
            return false;

        rear = (rear + 1) % size;
        a[rear] = x;
        count++;

        return true;
    }

    public int dequeue() {
        int x = a[front];
        front = (front + 1) % size;
        count--;

        return x;
    }

    public int front() {
        return a[front];
    }

    public boolean isFull() {
        return count == size;
    }

    public boolean isEmpty() {
        return count == 0;
    }
}
